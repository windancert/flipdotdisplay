menu "Flip-dot display"

    config FLIPDOT_WIFI_SSID
        string "WiFi SSID"
        default ""
        help
            Leave empty to run without networking (useful during bring-up).

    config FLIPDOT_WIFI_PASSWORD
        string "WiFi password"
        default ""

    config FLIPDOT_UDP_PORT
        int "UDP port for incoming frames"
        range 1 65535
        default 7777

    config FLIPDOT_BOOT_TEST
        bool "Show the panel orientation test at boot"
        default n
        help
            Lights a corner marker on each panel in turn, so the layout table in
            flipdot_map.c can be checked against the physical wiring.

endmenu
